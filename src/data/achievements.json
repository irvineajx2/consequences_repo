{
  "_note": "Achievements, in display order. A 'forEachRuler' entry is repeated for every ruler: {key} is the ruler's short name in lower case (elizabeth_history), {name} the short name itself. Conditions read only what the profile already records. Cross-ruler achievements ('endingsReached') need endings from several rulers, reached in any runs and any order.",
  "achievements": [
    {
      "id": "first_reign",
      "title": "First Reign",
      "description": "Finish any reign.",
      "condition": {
        "type": "runsCompleted",
        "atLeast": 1
      }
    },
    {
      "id": "uncharted",
      "title": "Uncharted",
      "description": "Visit a branch scene for the first time.",
      "condition": {
        "type": "branchScenesVisited",
        "atLeast": 1
      }
    },
    {
      "id": "off_the_map",
      "title": "Off the Map",
      "description": "Visit 10 different branch scenes across all rulers.",
      "condition": {
        "type": "branchScenesVisited",
        "atLeast": 10
      }
    },
    {
      "id": "faithful_copy",
      "title": "Faithful Copy",
      "description": "Match every decision in a single reign.",
      "condition": {
        "type": "everyDecisionMatched"
      }
    },
    {
      "forEachRuler": {
        "id": "{key}_history",
        "title": "In Their Footsteps: {name}",
        "description": "Reach {name}'s historical ending.",
        "condition": {
          "type": "endingCategory",
          "category": "historical"
        }
      }
    },
    {
      "forEachRuler": {
        "id": "{key}_outdone",
        "title": "Better Than History: {name}",
        "description": "Reach {name}'s outperform ending.",
        "hidden": true,
        "condition": {
          "type": "endingCategory",
          "category": "outperformed"
        }
      }
    },
    {
      "forEachRuler": {
        "id": "{key}_every_road",
        "title": "Every Road: {name}",
        "description": "Reach every one of {name}'s endings.",
        "condition": {
          "type": "everyEnding"
        }
      }
    },
    {
      "id": "legendary",
      "title": "Against All Odds",
      "description": "Reach any Legendary ending.",
      "condition": {
        "type": "endingRarity",
        "tier": "legendary"
      }
    },
    {
      "id": "rank_chronicler",
      "title": "Chronicler",
      "description": "Reach the rank of Chronicler.",
      "condition": {
        "type": "rank",
        "title": "Chronicler"
      }
    },
    {
      "id": "rank_sage",
      "title": "Sage",
      "description": "Reach the rank of Sage.",
      "condition": {
        "type": "rank",
        "title": "Sage"
      }
    },
    {
      "id": "sea_dog",
      "title": "Sea Dog",
      "description": "Reach an Elizabeth ending at sea.",
      "condition": {
        "type": "endingsReached",
        "all": [
          {
            "ruler": "elizabeth-i",
            "anyOf": [
              "gloriana",
              "mistress",
              "pyrrhic"
            ]
          }
        ]
      }
    },
    {
      "id": "royalist_victory",
      "title": "Royalist Victory",
      "description": "Win a battle as Charles.",
      "condition": {
        "type": "endingsReached",
        "all": [
          {
            "ruler": "charles-i",
            "anyOf": [
              "absolute_king"
            ]
          }
        ]
      }
    },
    {
      "id": "love_older_than_rome",
      "title": "A Love Older Than Rome",
